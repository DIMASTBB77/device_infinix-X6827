# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point		fs		device						device2			 device3			flags
# User writeable partitions
/boot			        emmc		/dev/block/platform/bootdevice/by-name//boot											flags=display=boot;slotselect;backup;flashimg
/dtbo			        emmc		/dev/block/platform/bootdevice/by-name//dtbo											flags=display=dtbo;slotselect;backup;flashimg
/vendor_boot		        emmc		/dev/block/platform/bootdevice/by-name//vendor_boot								                flags=display=vendor_boot;slotselect;backup;flashimg
/vbmeta			        emmc		/dev/block/platform/bootdevice/by-name//vbmeta									        flags=display=vbmeta;slotselect;backup;flashimg
/vbmeta_system		        emmc		/dev/block/platform/bootdevice/by-name//vbmeta_system								        flags=display=vbmeta_system;slotselect;backup;flashimg
/vbmeta_vendor		        emmc		/dev/block/platform/bootdevice/by-name//vbmeta_vendor							                flags=display=vbmeta_vendor;slotselect;backup;flashimg
/gz			        emmc		/dev/block/platform/bootdevice/by-name//gz											flags=display=gz;slotselect;backup;flashimg
/lk			        emmc		/dev/block/platform/bootdevice/by-name//lk											flags=display=lk;slotselect;backup;flashimg
/md1img			        emmc		/dev/block/platform/bootdevice/by-name//md1img										flags=display=md1img;slotselect;backup;flashimg

# Firmware
/metadata		        ext4		/dev/block/platform/bootdevice/by-name//metadata										flags=display=metadata;backup
/misc			        emmc		/dev/block/platform/bootdevice/by-name//misc											flags=display=misc;backup

# Sensitive Data
/nvcfg			        ext4		/dev/block/platform/bootdevice/by-name//nvcfg										flags=display=nvcfg;backup
/persist_image		        emmc		/dev/block/platform/bootdevice/by-name//persist										flags=display=persist;backup
/persistent	        	emmc		/dev/block/platform/bootdevice/by-name//frp											flags=display=persistent;backup

# IMEI and modem related
/nvdata			        ext4		/dev/block/platform/bootdevice/by-name//nvdata										flags=display=nvdata;backup
/protect_f		        ext4		/dev/block/platform/bootdevice/by-name//protect1										flags=display=protect_f;backup
/protect_s		        ext4		/dev/block/platform/bootdevice/by-name//protect2										flags=display=protect_s;backup
/nvram			        emmc		/dev/block/platform/bootdevice/by-name//nvram										flags=display=nvram;backup

# Standard MediaTeks's partitions
/logo			        emmc		/dev/block/platform/bootdevice/by-name//logo											flags=display=logo;slotselect;backup;flashimg
/scp			        emmc		/dev/block/platform/bootdevice/by-name//scp											flags=display=scp;slotselect;backup;flashimg
/spmfw			        emmc		/dev/block/platform/bootdevice/by-name//spmfw										flags=display=spmfw;slotselect;backup;flashimg
/sspm			        emmc		/dev/block/platform/bootdevice/by-name//sspm											flags=display=sspm;slotselect;backup;flashimg
/tee			        emmc		/dev/block/platform/bootdevice/by-name//tee											flags=display=tee;slotselect;backup;flashimg
/tkv			        emmc		/dev/block/platform/bootdevice/by-name//tkv											flags=display=tkv;slotselect;backup;flashimg
/otp			        emmc		/dev/block/platform/bootdevice/by-name//otp											flags=display=otp;backup
/expdb			        emmc		/dev/block/platform/bootdevice/by-name//expdb										flags=display=expdb;backup
/para			        emmc		/dev/block/platform/bootdevice/by-name//para											flags=display=para;backup;
/sec1			        emmc		/dev/block/platform/bootdevice/by-name//sec1											flags=display=sec1;backup
/seccfg			        emmc		/dev/block/platform/bootdevice/by-name//seccfg										flags=display=seccfg;backup
/proinfo			emmc		/dev/block/platform/bootdevice/by-name//proinfo										flags=display=proinfo;backup
/boot_para			emmc		/dev/block/platform/bootdevice/by-name//boot_para									        flags=display=boot_para;backup
/flashinfo			emmc		/dev/block/platform/bootdevice/by-name//flashinfo									        flags=display=flashinfo;backup

# Removable Storage
# Removable
/external_sd        auto      /dev/block/mmcblk1p1      /dev/block/mmcblk1                  flags=storage;wipeingui;removable
/usb_otg            auto      /dev/block/sda1           /dev/block/sdd                      flags=storage;wipeingui;removable;display="USB OTG"
# Flashable logical partitions

# Flashable logical partitions
/system_image		emmc		/dev/block/bootdevice/by-name/system									flags=backup;display="System";flashimg
/vendor_image		emmc		/dev/block/bootdevice/by-name/vendor									flags=backup;display="Vendor";flashimg
/system_ext_image	emmc		/dev/block/bootdevice/by-name/system_ext								flags=display="System_ext";backup;flashimg
/product_image		emmc		/dev/block/bootdevice/by-name/product									flags=display="Product";backup;flashimg
